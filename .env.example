# =============================================================================
# VARIABLES DE ENTORNO (PLANTILLA EJEMPLO) - FRONTEND VITE + REACT 19
# =============================================================================

# URL base del API Backend (NestJS)
# En desarrollo local: http://localhost:3000/api
# En producción Docker: se inyecta automáticamente como /api a través de build args en docker-compose
VITE_API_URL=http://localhost:3000/api

# Nombre institucional de la aplicación
VITE_APP_NAME="Sistema Enterprise"

# Habilitar datos simulados de respaldo cuando la API no esté conectada (true / false)
VITE_ENABLE_MOCK_FALLBACK=false

# Puerto expuesto por el contenedor Docker en producción (80, 8080, etc.)
FRONTEND_PORT=80

# Feature Flag: Bot de Discord y Reproductor de Audio
VITE_FEATURE_DISCORD_BOT=true
